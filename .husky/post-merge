#!/bin/sh

# Scripts skip their usage row when this is set, since no one chose to run them; Nx task timings
# keep theirs, tagged with this hook's name.
export JOINERY_GIT_HOOK=post-merge

# Git sets GIT_DIR in a linked worktree's hooks, so a tool run from a package folder took that
# folder for the repo root; unset, git finds the same repository from the hook's cwd.
unset GIT_DIR

YELLOW="\033[1;33m"
NC="\033[0m"

if ! git rev-parse --verify 'ORIG_HEAD^{commit}' >/dev/null 2>&1 || \
    ! git rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1; then
    exit 0
fi

STATUS=0
git diff --quiet ORIG_HEAD HEAD -- pnpm-lock.yaml >/dev/null 2>&1 || STATUS=$?

# pnpm keeps the lockfile it last installed here, minus the leading packageManager document.
INSTALLED=node_modules/.pnpm/lock.yaml

if [ "$STATUS" -eq 1 ] && ! awk 'NR == 1 && $0 == "---" { skip = 1; next }
    skip && $0 == "---" { skip = 0; next }
    !skip' pnpm-lock.yaml | cmp -s - "$INSTALLED"; then
    printf "\n${YELLOW}📦 ${NC}pnpm-lock.yaml changed — run pnpm install.\n"
fi

if ! git diff --quiet ORIG_HEAD HEAD -- ':(glob)**/.env.example' >/dev/null 2>&1; then
    printf "\n${YELLOW}🔑 ${NC}A .env.example changed — syncing .env files.\n"
    pnpm env:sync || true
fi


# A worktree is a ship-issue run's, whose ship step stops on a file it didn't write.
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ]; then
    (pnpm workflow:sync >/dev/null 2>&1 &)
fi

exit 0
