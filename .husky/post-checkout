#!/bin/sh

# Scripts record a usage row unless this is set; a hook running them is not anyone choosing to.
export JOINERY_GIT_HOOK=1

# Git sets GIT_DIR in a linked worktree's hooks, so a tool run from a package folder took that
# folder for the repo root; unset, git finds the same repository from the hook's cwd.
unset GIT_DIR

YELLOW="\033[1;33m"
NC="\033[0m"

if [ "$#" -ne 3 ] || [ "$3" != "1" ]; then
    exit 0
fi

if ! git rev-parse --verify "$1^{commit}" >/dev/null 2>&1 || \
    ! git rev-parse --verify "$2^{commit}" >/dev/null 2>&1; then
    exit 0
fi

STATUS=0
git diff --quiet "$1" "$2" -- pnpm-lock.yaml >/dev/null 2>&1 || STATUS=$?

# pnpm keeps the lockfile it last installed here, minus the leading packageManager document.
INSTALLED=node_modules/.pnpm/lock.yaml

if [ "$STATUS" -eq 1 ] && ! awk 'NR == 1 && $0 == "---" { skip = 1; next }
    skip && $0 == "---" { skip = 0; next }
    !skip' pnpm-lock.yaml | cmp -s - "$INSTALLED"; then
    printf "\n${YELLOW}📦 ${NC}pnpm-lock.yaml changed — run pnpm install.\n"
fi

if ! git diff --quiet "$1" "$2" -- ':(glob)**/.env.example' >/dev/null 2>&1; then
    printf "\n${YELLOW}🔑 ${NC}A .env.example changed — syncing .env files.\n"
    pnpm env:sync || true
fi


# A worktree is a ship-issue run's, whose ship step stops on a file it didn't write.
# Master is left to post-merge: synced before the pull, it dirties the snapshot and blocks the pull.
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] && \
    [ "$(git branch --show-current)" != "master" ]; then
    (pnpm workflow:sync >/dev/null 2>&1 &)
fi

exit 0
