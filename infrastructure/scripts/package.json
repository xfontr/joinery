{
  "name": "@monorepo/scripts",
  "version": "0.0.0",
  "description": "repo-local dev tooling, one folder per script",
  "private": true,
  "author": "Xifré Font",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "pnpm --silent cli src/dev/index.ts",
    "issue:add": "pnpm --silent cli src/issue/index.ts add",
    "issue:pick": "pnpm --silent cli src/issue/index.ts pick",
    "issue:brief": "pnpm --silent cli src/issue/index.ts brief",
    "issue:ship": "pnpm --silent cli src/ship/index.ts",
    "ci:failures": "pnpm --silent cli src/ci-failures/index.ts",
    "worktree:prepare": "pnpm --silent cli src/worktree/index.ts",
    "docs:drift": "pnpm --silent cli src/drift/index.ts",
    "docs:map": "pnpm --silent cli src/map/index.ts",
    "invariants:check": "pnpm --silent cli src/invariants/index.ts",
    "usage:flush": "pnpm --silent cli src/usage/index.ts",
    "env:sync": "pnpm --silent cli src/env-sync/index.ts",
    "workflow:setup": "pnpm --silent cli src/workflow/index.ts setup",
    "workflow:sync": "pnpm --silent cli src/workflow/index.ts sync",
    "workflow:next": "pnpm --silent cli src/workflow/index.ts next",
    "workflow:file": "pnpm --silent cli src/workflow/index.ts file",
    "workflow:drop": "pnpm --silent cli src/workflow/index.ts drop",
    "coverage": "pnpm --silent cli src/coverage-report/index.ts",
    "cli": "node --disable-warning=ExperimentalWarning",
    "lint": "nx eslint:lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest . --watch=false --passWithNoTests",
    "test:dev": "vitest .",
    "test:coverage": "vitest . --watch=false --coverage --passWithNoTests"
  },
  "nx": {
    "tags": [
      "type:tooling",
      "scope:tooling"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@monorepo/configs": "workspace:*",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
